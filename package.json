{
  "name": "@tbroker/ui",
  "version": "0.1.0",
  "description": "Tbroker UI component set built with MUI v9 and Tailwind CSS v4",
  "type": "module",
  "license": "MIT",
  "main": "./dist/tbroker-ui.cjs",
  "module": "./dist/tbroker-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tbroker-ui.js",
      "require": "./dist/tbroker-ui.cjs"
    },
    "./styles.css": "./dist/tbroker-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@storybook/addon-a11y": "^10.0.6",
    "@storybook/addon-docs": "^10.0.6",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  }
}
